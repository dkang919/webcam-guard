# 기본: 저장소 안에서는 LF로 정규화한다.
* text=auto eol=lf

# 내려받은 서드파티 자산은 git이 건드리면 안 된다.
# hls.min.js 는 텍스트로 인식되지만 vendor.py 가 받은 원본 그대로여야
# 무결성 검사(파일 크기)와 재다운로드 비교가 의미를 가진다.
static/hls.min.js  -text
*.woff2            binary
*.mp4              binary
*.ts               binary

# 배치 파일은 CRLF 여야 cmd.exe 가 안전하게 읽는다.
*.bat              text eol=crlf
*.bat.example      text eol=crlf
