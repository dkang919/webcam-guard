@echo off
chcp 65001 >nul
REM ===================================================================
REM  이 파일을 복사해서 start_guard.bat 으로 저장하면 끝.
REM  고칠 내용은 없다 — 카메라 이름과 비밀번호는 .env 에서 읽는다.
REM
REM  자동 실행: Win+R -> shell:startup -> 이 .bat 의 바로가기를 넣기
REM ===================================================================
setlocal

cd /d "%~dp0"
title Guard

if not exist ".env" (
  echo [start_guard] .env 가 없어. .env.example 을 복사해서 만들고 다시 실행해.
  pause
  exit /b 1
)

REM guard.py 자체가 죽는 경우(파이썬 예외)를 대비한 바깥쪽 재시작 루프.
REM ffmpeg 이 죽는 건 guard.py 안의 워치독이 이미 처리하고,
REM guard.py 가 죽으면 ffmpeg 도 Job Object 로 같이 정리된다.
:loop
python guard.py
echo.
echo [start_guard] guard.py 가 종료됐어. 10초 뒤 재시작한다. 완전히 끄려면 이 창을 닫아.
timeout /t 10 /nobreak >nul
goto loop
