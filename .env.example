# 이 파일을 복사해서 .env 로 저장하고 값을 채워.
# .env 는 .gitignore 에 있어서 커밋되지 않는다.
#
# 우선순위: 명령줄 인자 > 환경변수(.env 포함) > guard.py 의 기본값
# 즉 여기에 적어두고, 필요할 때만 --port 같은 인자로 덮어쓰면 된다.
#
# 이름 규칙: guard.py 의 설정 이름 앞에 GUARD_ 를 붙이고 대문자로.
#   --retain-days  ->  GUARD_RETAIN_DAYS

# 뷰어 접속 비밀번호. 아이디는 admin (GUARD_USER 로 변경 가능)
GUARD_PASSWORD=여기에_비밀번호

# 카메라 이름. python guard.py --list 에서 따옴표 안 이름 그대로
GUARD_DEVICE=HD Pro Webcam C920

# 아래는 전부 선택 사항. 지우면 기본값을 쓴다.

# --- 저장 ---------------------------------------------------------------
#GUARD_ROOT=C:\CamRecordings
#GUARD_RETAIN_DAYS=10        보관 일수. 늘리면 MAX_GB 도 같이 늘려야 한다
#GUARD_MAX_GB=200            용량 상한. 둘 중 먼저 걸리는 쪽이 이긴다
#GUARD_SEGMENT_SECONDS=600   파일 하나의 길이

# --- 화질 (용량을 정하는 건 BITRATE 다. FPS 는 CPU 쪽) --------------------
#GUARD_SIZE=1280x720
#GUARD_FPS=15
#GUARD_BITRATE=1500k
#GUARD_INPUT_CODEC=mjpeg     프레임이 낮거나 입력이 실패할 때
#GUARD_TIMESTAMP=false       화면 속 시각 표시 끄기

# --- 로그북 (움직임·얼굴) -----------------------------------------------
#GUARD_LOGBOOK=false         로그북 자체를 끄기
#GUARD_MOTION_THRESHOLD=1.0  화면의 몇 %가 바뀌어야 움직임인지
#                            tools/calibrate.py 로 방에 맞게 재보정할 것
#GUARD_FACES=false           얼굴 감지만 끄기 (움직임은 계속 기록)
#GUARD_EVENT_GAP=10          몇 초 조용하면 한 사건이 끝난 걸로 볼지

# --- 접속 ---------------------------------------------------------------
#GUARD_PORT=8088
#GUARD_USER=admin            뷰어 로그인 아이디
#GUARD_CHANNEL=ROOM 01       뷰어 상단에 뜨는 이름. 카메라가 여러 대면 구분용
#GUARD_FFMPEG=C:\경로\ffmpeg.exe
