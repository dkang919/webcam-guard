# Copy this file to .env and fill in the values.
# .env is gitignored, so it never reaches the repository.
# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 gitignore 되어 커밋되지 않는다.
#
# Precedence: CLI flag > environment (this file) > built-in default.
# Keep everyday values here; override with a flag when you need a one-off.
# 우선순위: 명령줄 인자 > 환경변수(이 파일) > 기본값
#
# Naming: take the setting name from guard.py, upper-case it, prefix GUARD_.
#   --retain-days  ->  GUARD_RETAIN_DAYS

# Viewer password. Username is admin (change with GUARD_USER).
# 뷰어 접속 비밀번호. 아이디는 admin
GUARD_PASSWORD=put-your-password-here

# Camera name, copied verbatim from the quotes in `python guard.py --list`
# 카메라 이름. python guard.py --list 의 따옴표 안 이름을 그대로
GUARD_DEVICE=Your Camera Name


# Everything below is optional; delete a line to use the default.
# 아래는 전부 선택 사항. 지우면 기본값을 쓴다.

# --- storage / 저장 ------------------------------------------------------
#GUARD_ROOT=C:\CamRecordings
#GUARD_RETAIN_DAYS=10        Days to keep. Raise MAX_GB with it.
#                            보관 일수. 늘리면 MAX_GB 도 같이 늘려야 한다
#GUARD_MAX_GB=200            Size cap. Whichever limit hits first wins.
#                            용량 상한. 둘 중 먼저 걸리는 쪽이 이긴다
#GUARD_SEGMENT_SECONDS=600   Length of one clip file / 파일 하나의 길이

# --- quality / 화질 ------------------------------------------------------
# BITRATE decides disk usage; FPS is about CPU.
# 용량을 정하는 건 BITRATE. FPS 는 CPU 쪽이다.
#GUARD_SIZE=1280x720
#GUARD_FPS=15
#GUARD_BITRATE=1500k
#GUARD_INPUT_CODEC=mjpeg     Try this if the frame rate is low or input fails
#                            프레임이 낮거나 입력이 실패할 때
#GUARD_TIMESTAMP=false       Turn off the burnt-in clock / 시각 표시 끄기

# --- logbook (motion + faces) / 로그북 -----------------------------------
#GUARD_LOGBOOK=false         Disable the logbook entirely / 로그북 끄기
#GUARD_MOTION_THRESHOLD=1.0  Percent of the picture that must change.
#                            Retune per room with tools/calibrate.py
#                            화면의 몇 %가 바뀌어야 움직임인지
#GUARD_FACES=false           Motion only, no face detection / 얼굴 감지만 끄기
#GUARD_EVENT_GAP=10          Seconds of quiet that close an event
#                            몇 초 조용하면 한 사건이 끝난 걸로 볼지

# --- access / 접속 -------------------------------------------------------
#GUARD_PORT=8088
#GUARD_USER=admin            Viewer login name / 뷰어 로그인 아이디
#GUARD_CHANNEL=ROOM 01       Shown at the top of the viewer / 뷰어 상단 이름
#GUARD_FFMPEG=C:\path\to\ffmpeg.exe
